# Alamat backend FastAPI.
# Kosongkan saat development: Vite akan mem-proxy /api ke http://127.0.0.1:8000.
# Isi hanya jika backend di-deploy di alamat lain (alamat frontend harus
# didaftarkan di RUL_CORS_ORIGINS pada backend).
# VITE_API_BASE_URL=https://your-backend.example.com

# Opsional: ubah target proxy dev jika backend tidak di 127.0.0.1:8000
# VITE_DEV_API_TARGET=http://127.0.0.1:8000
